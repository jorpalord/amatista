{
  "name": "amatista",
  "productName": "Amatista",
  "version": "0.11.4",
  "private": true,
  "description": "Multi-model desktop agent workspace with pluggable AI providers.",
  "author": "Jorge Pablo Ramirez Carvajal",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run mcp:lsp:bundle",
    "dist": "npm run build && electron-builder --win nsis",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "bench:bundle": "esbuild benchmark/run-instance.ts --bundle --platform=node --format=cjs --outfile=benchmark/dist/run-instance.cjs --alias:electron=./benchmark/electron-stub.cjs --external:@napi-rs/canvas --external:pdfjs-dist --log-level=warning",
    "mcp:lsp:bundle": "esbuild src/main/mcp-lsp-server.ts --bundle --platform=node --format=cjs --outfile=out/main/mcp-lsp-server.cjs --external:electron --log-level=warning",
    "test:regression": "esbuild \"tests/regression/*.test.ts\" --bundle --platform=node --format=cjs --alias:electron=./tests/regression/_support/electron-stub.cjs --external:@napi-rs/canvas --external:pdfjs-dist --outdir=tests/regression/.dist --log-level=warning && node tests/regression/_support/run.cjs"
  },
  "build": {
    "appId": "com.amatista.agentstudio",
    "productName": "Amatista",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/typescript-language-server/**/*",
      "node_modules/typescript/**/*",
      "node_modules/pyright/**/*",
      "node_modules/yaml-language-server/**/*",
      "node_modules/vscode-langservers-extracted/**/*",
      "node_modules/bash-language-server/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/officeparser/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/@xmldom/**/*",
      "node_modules/fflate/**/*",
      "node_modules/file-type/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/bmp-js/**/*",
      "node_modules/idb-keyval/**/*",
      "node_modules/is-url/**/*",
      "node_modules/node-fetch/**/*",
      "node_modules/opencollective-postinstall/**/*",
      "node_modules/regenerator-runtime/**/*",
      "node_modules/wasm-feature-detect/**/*",
      "node_modules/zlibjs/**/*"
    ],
    "asarUnpack": [
      "node_modules/typescript-language-server/**/*",
      "node_modules/typescript/**/*",
      "node_modules/pyright/**/*",
      "node_modules/yaml-language-server/**/*",
      "node_modules/vscode-langservers-extracted/**/*",
      "node_modules/bash-language-server/**/*",
      "node_modules/@astrojs/language-server/**/*",
      "node_modules/svelte-language-server/**/*",
      "node_modules/@prisma/language-server/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/@nut-tree-fork/**/*",
      "out/main/mcp-lsp-server.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/amatista.ico",
      "artifactName": "Amatista-V${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Amatista"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "pdfjs-dist": "^6.3.289"
  },
  "dependencies": {
    "@astrojs/language-server": "^2.16.16",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "4.7.0",
    "@napi-rs/canvas": "^1.0.8",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@prisma/language-server": "^6.19.0-hotfix.1",
    "bash-language-server": "^5.6.0",
    "monaco-editor": "0.55.1",
    "officeparser": "^7.8.0",
    "pdfjs-dist": "^6.3.289",
    "pyright": "^1.1.413",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "^1.8.0",
    "svelte-language-server": "^0.18.4",
    "typescript": "^6.0.0",
    "typescript-language-server": "^6.0.0",
    "vscode-langservers-extracted": "^4.10.0",
    "yaml": "^2.8.1",
    "yaml-language-server": "^1.24.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "5.0.0",
    "vite": "^7.3.6"
  }
}
